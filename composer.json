{
    "name": "md3/md3-wp-mcp",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Dariel Corchado"
        },
        {
            "name": "Jenrry Cordero"
        }
    ],
    "require": {
        "wordpress/mcp-adapter": "^0.7.1",
        "league/oauth2-server": "^9.4",
        "nyholm/psr7": "^1.8",
        "automattic/jetpack-autoloader": "^6"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "automattic/jetpack-autoloader": true,
            "roots/wordpress-core-installer": true
        }
    },
    "extra": {
        "wordpress-install-dir": "tests/wp"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^4",
        "wp-phpunit/wp-phpunit": "7.1.*",
        "roots/wordpress-no-content": "7.1.*",
        "roots/wordpress-core-installer": "^4.0"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "description": "Content-only MCP server for WordPress with its own OAuth 2.1 server."
}
