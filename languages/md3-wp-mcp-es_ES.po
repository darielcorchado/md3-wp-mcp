#. Plugin Name of the plugin
#: md3-wp-mcp.php includes/abilities/class-registry.php:67
#: includes/oauth/class-authorize.php:445
#: includes/uploads/class-upload-page.php:358
msgid "MD3 WP MCP"
msgstr "MD3 WP MCP"

#. Plugin URI of the plugin
#: md3-wp-mcp.php
msgid "https://www.md3digitalsolutions.com"
msgstr "https://www.md3digitalsolutions.com"

#. Description of the plugin
#: md3-wp-mcp.php
msgid ""
"A content-only MCP server for WordPress with its own OAuth 2.1 server, so AI "
"assistants can read, draft and publish posts and pages without ever touching "
"code, users or settings."
msgstr ""
"Un servidor MCP solo de contenido para WordPress, con su propio servidor "
"OAuth 2.1, para que los asistentes de IA puedan leer, redactar y publicar "
"entradas y páginas sin tocar nunca el código, los usuarios ni los ajustes."

#. Author of the plugin
#: md3-wp-mcp.php
msgid "Dariel Corchado"
msgstr "Dariel Corchado"

#: includes/abilities/class-ability.php:90
msgid "The access token does not grant the scope this tool needs."
msgstr ""
"El token de acceso no concede el alcance que necesita esta herramienta."

#: includes/abilities/class-ability.php:128
msgid "Content not found."
msgstr "No se encontró el contenido."

#: includes/abilities/class-ability.php:131
#: includes/abilities/class-content-writer.php:50
#: includes/abilities/class-list-content.php:62
msgid "This content type is not enabled for MCP."
msgstr "Este tipo de contenido no está habilitado para MCP."

#. translators: %s: field name
#: includes/abilities/class-content-writer.php:44
#: includes/abilities/class-content-writer.php:178
#, php-format
msgid "Unknown field: %s"
msgstr "Campo desconocido: %s"

#: includes/abilities/class-content-writer.php:53
msgid "You are not allowed to create this content type."
msgstr "Usted no tiene permiso para crear este tipo de contenido."

#: includes/abilities/class-content-writer.php:58
msgid "Status must be draft or pending. Publishing is not available."
msgstr ""
"El estado debe ser borrador o pendiente. La publicación no está disponible."

#: includes/abilities/class-content-writer.php:148
msgid "terms must map a taxonomy to a list of term IDs."
msgstr "terms debe asignar una taxonomía a una lista de ID de términos."

#. translators: %s: taxonomy
#: includes/abilities/class-content-writer.php:153
#, php-format
msgid "Taxonomy \"%s\" is not available for this content type."
msgstr "La taxonomía \"%s\" no está disponible para este tipo de contenido."

#. translators: %s: taxonomy
#: includes/abilities/class-content-writer.php:156
#, php-format
msgid "You are not allowed to assign terms in \"%s\"."
msgstr "Usted no tiene permiso para asignar términos en \"%s\"."

#. translators: 1: term ID 2: taxonomy
#: includes/abilities/class-content-writer.php:160
#, php-format
msgid "Term %1$s does not exist in %2$s."
msgstr "El término %1$s no existe en %2$s."

#: includes/abilities/class-content-writer.php:168
msgid "featured_media must be the ID of an image in the media library."
msgstr ""
"featured_media debe ser el ID de una imagen de la biblioteca de medios."

#: includes/abilities/class-content-writer.php:174
msgid "seo must be an object."
msgstr "seo debe ser un objeto."

#: includes/abilities/class-content-writer.php:185
msgid "language needs Polylang, which is not active on this site."
msgstr "language necesita Polylang, que no está activo en este sitio."

#. translators: %s: field names
#: includes/abilities/class-content-writer.php:195
#, php-format
msgid "This content type does not support: %s"
msgstr "Este tipo de contenido no admite: %s"

#: includes/abilities/class-content-writer.php:201
msgid "parent must be an existing item of the same content type."
msgstr "parent debe ser un elemento existente del mismo tipo de contenido."

#: includes/abilities/class-content-writer.php:209
msgid "Unknown page template for the active theme."
msgstr "Plantilla de página desconocida para el tema activo."

#. translators: 1: language slug 2: valid slugs
#: includes/abilities/class-content-writer.php:229
#, php-format
msgid "Unknown language \"%1$s\". Available: %2$s"
msgstr "Idioma desconocido \"%1$s\". Disponibles: %2$s"

#: includes/abilities/class-create-content.php:15
msgid "Create content"
msgstr "Crear contenido"

#: includes/abilities/class-create-content.php:19
msgid "Creates a draft or pending post or page. Publishing is not available."
msgstr ""
"Crea una entrada o página en borrador o pendiente. La publicación no está "
"disponible."

#: includes/abilities/class-create-term.php:16
msgid "Create term"
msgstr "Crear término"

#: includes/abilities/class-create-term.php:20
msgid ""
"Creates a category, tag or other term in a taxonomy used by the enabled "
"content types."
msgstr ""
"Crea una categoría, etiqueta u otro término en una taxonomía usada por los "
"tipos de contenido habilitados."

#: includes/abilities/class-create-term.php:64
#: includes/abilities/class-list-terms.php:45
msgid "Unknown taxonomy for the enabled content types."
msgstr "Taxonomía desconocida para los tipos de contenido habilitados."

#: includes/abilities/class-create-term.php:68
msgid "You are not allowed to create terms in this taxonomy."
msgstr "Usted no tiene permiso para crear términos en esta taxonomía."

#: includes/abilities/class-create-term.php:73
msgid "The term name is empty."
msgstr "El nombre del término está vacío."

#: includes/abilities/class-create-term.php:82
msgid "parent must be an existing term of a hierarchical taxonomy."
msgstr "parent debe ser un término existente de una taxonomía jerárquica."

#: includes/abilities/class-create-upload-link.php:23
msgid "Create upload link"
msgstr "Crear enlace de carga"

#: includes/abilities/class-create-upload-link.php:27
msgid ""
"Creates a one-time link where the user uploads an image (JPEG, PNG, WebP or "
"GIF, up to 10 MB) from their browser to the media library. Use it when the "
"user attached or wants to add an image you cannot send with upload-media. "
"Show the link to the user; it works once and expires in 10 minutes. When "
"they say it is done, call get-upload with upload_id to get the media ID."
msgstr ""
"Crea un enlace de un solo uso para que el usuario suba una imagen (JPEG, "
"PNG, WebP o GIF, de hasta 10 MB) desde su navegador a la biblioteca de "
"medios. Úselo cuando el usuario adjuntó o quiere agregar una imagen que "
"usted no puede enviar con upload-media. Muestre el enlace al usuario; "
"funciona una sola vez y caduca en 10 minutos. Cuando el usuario diga que "
"terminó, llame a get-upload con upload_id para obtener el ID del medio."

#: includes/abilities/class-create-upload-link.php:69
msgid "Upload links can only be created over an MCP connection."
msgstr "Los enlaces de carga solo se pueden crear desde una conexión MCP."

#: includes/abilities/class-create-upload-link.php:72
#: includes/abilities/class-upload-media.php:74
msgid "You are not allowed to upload files."
msgstr "Usted no tiene permiso para subir archivos."

#: includes/abilities/class-create-upload-link.php:84
msgid "Too many upload links. Try again in a few minutes."
msgstr "Demasiados enlaces de carga. Inténtelo de nuevo en unos minutos."

#: includes/abilities/class-get-content.php:13
msgid "Get content"
msgstr "Obtener contenido"

#: includes/abilities/class-get-content.php:17
msgid ""
"Returns one post or page in full: raw block content, terms, featured image, "
"SEO fields and translations."
msgstr ""
"Devuelve una entrada o página completa: contenido de bloques sin procesar, "
"términos, imagen destacada, campos SEO y traducciones."

#: includes/abilities/class-get-content.php:41
msgid "You are not allowed to access this content."
msgstr "Usted no tiene permiso para acceder a este contenido."

#: includes/abilities/class-get-upload.php:19
msgid "Get upload"
msgstr "Obtener carga"

#: includes/abilities/class-get-upload.php:23
msgid ""
"Returns the status of an upload link from create-upload-link: waiting, "
"uploaded or expired. Once uploaded, it returns the image (media ID, URL, "
"size and alt text), ready for set-featured-image or the content."
msgstr ""
"Devuelve el estado de un enlace de carga de create-upload-link: waiting (en "
"espera), uploaded (subida) o expired (caducado). Una vez subida, devuelve la "
"imagen (ID del medio, URL, tamaño y texto alternativo), lista para set-"
"featured-image o el contenido."

#: includes/abilities/class-get-upload.php:45
msgid "Upload link not found. Links are kept for a day after they expire."
msgstr ""
"No se encontró el enlace de carga. Los enlaces se conservan un día después "
"de caducar."

#: includes/abilities/class-link-translations.php:19
msgid "Link translations"
msgstr "Vincular traducciones"

#: includes/abilities/class-link-translations.php:23
msgid ""
"Sets the language of a post or page and links it with its translations in "
"other languages (Polylang)."
msgstr ""
"Establece el idioma de una entrada o página y la vincula con sus "
"traducciones en otros idiomas (Polylang)."

#: includes/abilities/class-link-translations.php:65
#: includes/abilities/class-set-featured-image.php:60
#: includes/abilities/class-update-content.php:64
#: includes/abilities/class-upload-media.php:122
msgid "You are not allowed to edit this content."
msgstr "Usted no tiene permiso para editar este contenido."

#: includes/abilities/class-link-translations.php:76
msgid "The translation in the item's own language must be the item itself."
msgstr ""
"La traducción en el idioma del propio elemento debe ser el mismo elemento."

#: includes/abilities/class-link-translations.php:91
msgid "You are not allowed to edit a translation you listed."
msgstr "Usted no tiene permiso para editar una de las traducciones que indicó."

#: includes/abilities/class-link-translations.php:94
msgid "Translations must be of the same content type."
msgstr "Las traducciones deben ser del mismo tipo de contenido."

#: includes/abilities/class-link-translations.php:104
msgid "Each translation must be a different item."
msgstr "Cada traducción debe ser un elemento distinto."

#: includes/abilities/class-link-translations.php:176
msgid ""
"This would replace or move an existing translation. Unlink it in wp-admin "
"first."
msgstr ""
"Esto reemplazaría o movería una traducción existente. Desvincúlela primero "
"en wp-admin."

#: includes/abilities/class-list-content.php:17
msgid "List content"
msgstr "Listar contenido"

#: includes/abilities/class-list-content.php:21
msgid ""
"Lists posts, pages and other enabled content, including drafts, with filters "
"and pagination."
msgstr ""
"Lista entradas, páginas y otro contenido habilitado, incluidos los "
"borradores, con filtros y paginación."

#: includes/abilities/class-list-content.php:93
#: includes/abilities/class-list-content.php:98
msgid "Pass a taxonomy of an enabled content type together with term_id."
msgstr ""
"Indique una taxonomía de un tipo de contenido habilitado junto con term_id."

#: includes/abilities/class-list-media.php:18
msgid "List media"
msgstr "Listar medios"

#: includes/abilities/class-list-media.php:22
msgid ""
"Lists images in the media library, newest first, searching the title, "
"caption, description and file name. Use it to reuse an existing image (for "
"example with set-featured-image) instead of uploading it again. Use "
"missing_alt to find images that still need alt text."
msgstr ""
"Lista las imágenes de la biblioteca de medios, de la más reciente a la más "
"antigua, buscando en el título, la leyenda, la descripción y el nombre del "
"archivo. Úselo para reutilizar una imagen existente (por ejemplo, con set-"
"featured-image) en lugar de subirla de nuevo. Use missing_alt para encontrar "
"las imágenes que todavía no tienen texto alternativo."

#: includes/abilities/class-list-media.php:53
msgid "You are not allowed to see the media library."
msgstr "No tiene permiso para ver la biblioteca de medios."

#: includes/abilities/class-list-post-types.php:15
msgid "List post types"
msgstr "Listar tipos de contenido"

#: includes/abilities/class-list-post-types.php:19
msgid ""
"Lists the content types this site lets you work with, with the taxonomies "
"and features each supports."
msgstr ""
"Lista los tipos de contenido con los que este sitio le permite trabajar, con "
"las taxonomías y funciones que admite cada uno."

#: includes/abilities/class-list-terms.php:13
msgid "List terms"
msgstr "Listar términos"

#: includes/abilities/class-list-terms.php:17
msgid ""
"Lists the terms (categories, tags, ...) of a taxonomy used by the enabled "
"content types."
msgstr ""
"Lista los términos (categorías, etiquetas, ...) de una taxonomía usada por "
"los tipos de contenido habilitados."

#: includes/abilities/class-publish-content.php:15
msgid "Publish content"
msgstr "Publicar contenido"

#: includes/abilities/class-publish-content.php:19
msgid ""
"Publishes a post or page now, or schedules it with a date. A date without a "
"UTC offset is read in the site time zone; a past date publishes immediately "
"with that date."
msgstr ""
"Publica una entrada o página ahora, o la programa con una fecha. Una fecha "
"sin desfase UTC se interpreta en la zona horaria del sitio; una fecha pasada "
"se publica de inmediato con esa fecha."

#: includes/abilities/class-publish-content.php:57
msgid "You are not allowed to publish this content."
msgstr "Usted no tiene permiso para publicar este contenido."

#: includes/abilities/class-publish-content.php:60
msgid "Restore this content before publishing it."
msgstr "Restaure este contenido antes de publicarlo."

#: includes/abilities/class-publish-content.php:68
msgid "date must be ISO 8601 or \"Y-m-d H:i\"."
msgstr "date debe estar en formato ISO 8601 o \"Y-m-d H:i\"."

#: includes/abilities/class-registry.php:68
msgid "Read and edit site content."
msgstr "Leer y editar el contenido del sitio."

#: includes/abilities/class-restore-content.php:15
msgid "Restore content"
msgstr "Restaurar contenido"

#: includes/abilities/class-restore-content.php:19
msgid "Restores trashed content. It comes back as a draft."
msgstr "Restaura contenido de la papelera. Vuelve como borrador."

#: includes/abilities/class-restore-content.php:53
msgid "You are not allowed to restore this content."
msgstr "Usted no tiene permiso para restaurar este contenido."

#: includes/abilities/class-restore-content.php:56
msgid "This content is not in the trash."
msgstr "Este contenido no está en la papelera."

#: includes/abilities/class-restore-content.php:60
msgid "The content could not be restored."
msgstr "No se pudo restaurar el contenido."

#: includes/abilities/class-set-featured-image.php:15
msgid "Set featured image"
msgstr "Establecer imagen destacada"

#: includes/abilities/class-set-featured-image.php:19
msgid ""
"Sets the featured image of a post or page to an image from the media "
"library. Changing live content needs the publish scope."
msgstr ""
"Establece la imagen destacada de una entrada o página con una imagen de la "
"biblioteca de medios. Cambiar contenido publicado requiere el alcance de "
"publicación."

#: includes/abilities/class-set-featured-image.php:64
msgid "media_id must be the ID of an image in the media library."
msgstr "media_id debe ser el ID de una imagen de la biblioteca de medios."

#: includes/abilities/class-trash-content.php:15
msgid "Trash content"
msgstr "Enviar contenido a la papelera"

#: includes/abilities/class-trash-content.php:19
msgid ""
"Moves a post or page to the trash. It can be restored; nothing is "
"permanently deleted."
msgstr ""
"Mueve una entrada o página a la papelera. Se puede restaurar; nada se "
"elimina de forma permanente."

#: includes/abilities/class-trash-content.php:53
msgid "You are not allowed to trash this content."
msgstr "Usted no tiene permiso para enviar este contenido a la papelera."

#: includes/abilities/class-trash-content.php:56
msgid "This content is already in the trash."
msgstr "Este contenido ya está en la papelera."

#: includes/abilities/class-trash-content.php:61
msgid ""
"The trash is disabled on this site, so content cannot be trashed safely."
msgstr ""
"La papelera está desactivada en este sitio, por lo que el contenido no se "
"puede enviar a ella de forma segura."

#: includes/abilities/class-trash-content.php:65
msgid "The content could not be moved to the trash."
msgstr "No se pudo enviar el contenido a la papelera."

#: includes/abilities/class-unpublish-content.php:15
msgid "Unpublish content"
msgstr "Despublicar contenido"

#: includes/abilities/class-unpublish-content.php:19
msgid "Moves content back to draft (published, scheduled, pending or private)."
msgstr ""
"Devuelve el contenido a borrador (publicado, programado, pendiente o "
"privado)."

#: includes/abilities/class-unpublish-content.php:54
msgid "You are not allowed to unpublish this content."
msgstr "Usted no tiene permiso para despublicar este contenido."

#: includes/abilities/class-unpublish-content.php:57
msgid "This content is in the trash."
msgstr "Este contenido está en la papelera."

#: includes/abilities/class-update-content.php:15
msgid "Update content"
msgstr "Actualizar contenido"

#: includes/abilities/class-update-content.php:19
msgid ""
"Updates the given fields of a post or page. Changing live content needs the "
"publish scope."
msgstr ""
"Actualiza los campos indicados de una entrada o página. Cambiar contenido "
"publicado requiere el alcance de publicación."

#: includes/abilities/class-update-content.php:61
msgid "Restore this content before editing it."
msgstr "Restaure este contenido antes de editarlo."

#: includes/abilities/class-update-media.php:28
msgid "Update media"
msgstr "Actualizar medios"

#: includes/abilities/class-update-media.php:32
msgid ""
"Changes the alt text, title, caption or description of an image in the media "
"library. Only the fields sent change; an empty string clears one. Images "
"already placed in post content keep their own alt text and caption: change "
"those with update-content. Changing the featured image of, or an image "
"attached to, published, scheduled or private content needs the publish scope."
msgstr ""
"Cambia el texto alternativo, el título, la leyenda o la descripción de una "
"imagen de la biblioteca de medios. Solo cambian los campos enviados; una "
"cadena vacía borra uno. Las imágenes ya colocadas en el contenido de una "
"entrada conservan su propio texto alternativo y leyenda: cámbielos con "
"update-content. Cambiar la imagen destacada de un contenido publicado, "
"programado o privado, o una imagen adjunta a él, requiere el permiso de "
"publicación."

#: includes/abilities/class-update-media.php:103
msgid "Image not found in the media library."
msgstr "No se encontró la imagen en la biblioteca de medios."

#: includes/abilities/class-update-media.php:106
msgid "You are not allowed to edit this image."
msgstr "No tiene permiso para editar esta imagen."

#: includes/abilities/class-update-media.php:116
msgid "Send at least one of alt, title, caption or description."
msgstr "Envíe al menos uno de alt, title, caption o description."

#: includes/abilities/class-upload-media.php:25
msgid "Upload media"
msgstr "Subir medios"

#: includes/abilities/class-upload-media.php:29
msgid ""
"Adds an image (JPEG, PNG, WebP or GIF, up to 10 MB) to the media library, "
"from a public URL or base64 data. Give exactly one of url or base64; base64 "
"also needs filename."
msgstr ""
"Agrega una imagen (JPEG, PNG, WebP o GIF, de hasta 10 MB) a la biblioteca de "
"medios, desde una URL pública o datos en base64. Indique exactamente uno de "
"url o base64; base64 también requiere filename."

#: includes/abilities/class-upload-media.php:80
msgid "Give exactly one of url or base64."
msgstr "Indique exactamente uno de url o base64."

#: includes/abilities/class-upload-media.php:83
msgid "filename is required with base64."
msgstr "filename es obligatorio con base64."

#: includes/abilities/class-upload-media.php:143
#: includes/abilities/class-upload-media.php:257
#: includes/abilities/class-upload-media.php:264
msgid "The file is larger than 10 MB."
msgstr "El archivo supera los 10 MB."

#: includes/abilities/class-upload-media.php:163
#: includes/abilities/class-upload-media.php:172
msgid "Only JPEG, PNG, WebP and GIF images are accepted."
msgstr "Solo se aceptan imágenes JPEG, PNG, WebP y GIF."

#: includes/abilities/class-upload-media.php:231
msgid "url must start with http:// or https://."
msgstr "url debe comenzar con http:// o https://."

#: includes/abilities/class-upload-media.php:261
msgid "base64 is not valid base64 data."
msgstr "base64 no son datos base64 válidos."

#: includes/abilities/class-upload-media.php:269
msgid "Could not create a temporary file."
msgstr "No se pudo crear un archivo temporal."

#: includes/abilities/class-upload-media.php:273
msgid "Could not write the temporary file."
msgstr "No se pudo escribir el archivo temporal."

#: includes/admin/class-diagnostics.php:70
msgid "OAuth keys load"
msgstr "Las claves OAuth se cargan"

#: includes/admin/class-diagnostics.php:76
msgid "Loaded."
msgstr "Cargadas."

#: includes/admin/class-diagnostics.php:80
msgid "Protected resource metadata is served and not cached"
msgstr ""
"Los metadatos del recurso protegido se sirven y no se almacenan en caché"

#. translators: 1: HTTP status, 2: Content-Type, 3: Cache-Control.
#: includes/admin/class-diagnostics.php:92
#, php-format
msgid "HTTP %1$d, Content-Type \"%2$s\", Cache-Control \"%3$s\"."
msgstr "HTTP %1$d, Content-Type \"%2$s\", Cache-Control \"%3$s\"."

#: includes/admin/class-diagnostics.php:96
msgid "Authorization server metadata is served"
msgstr "Los metadatos del servidor de autorización se sirven"

#. translators: %d: HTTP status.
#: includes/admin/class-diagnostics.php:107
#, php-format
msgid "HTTP %d."
msgstr "HTTP %d."

#: includes/admin/class-diagnostics.php:111
msgid "The MCP endpoint refuses requests without a token"
msgstr "El endpoint MCP rechaza las solicitudes sin token"

#. translators: 1: HTTP status, 2: whether a WWW-Authenticate header was sent (yes/no).
#: includes/admin/class-diagnostics.php:129
#, php-format
msgid "HTTP %1$d, WWW-Authenticate header: %2$s."
msgstr "HTTP %1$d, encabezado WWW-Authenticate: %2$s."

#. translators: 1: HTTP status, 2: whether a WWW-Authenticate header was sent (yes/no).
#: includes/admin/class-diagnostics.php:129
msgid "yes"
msgstr "sí"

#. translators: 1: HTTP status, 2: whether a WWW-Authenticate header was sent (yes/no).
#: includes/admin/class-diagnostics.php:129
msgid "no"
msgstr "no"

#: includes/admin/class-diagnostics.php:133
msgid "The Authorization header reaches PHP"
msgstr "El encabezado Authorization llega a PHP"

#: includes/admin/class-diagnostics.php:151
msgid "Received."
msgstr "Recibido."

#. translators: %d: HTTP status.
#: includes/admin/class-diagnostics.php:153
#, php-format
msgid ""
"Not received (HTTP %d). The web server strips the Authorization header; pass "
"it to PHP."
msgstr ""
"No recibido (HTTP %d). El servidor web elimina el encabezado Authorization; "
"páselo a PHP."

#: includes/admin/class-diagnostics.php:158
msgid "The authorize page is reachable and not cached or redirected"
msgstr ""
"La página de autorización es accesible y no está en caché ni redirigida"

#. translators: %d: HTTP status.
#: includes/admin/class-diagnostics.php:166
#, php-format
msgid "HTTP %d without parameters (400 expected)."
msgstr "HTTP %d sin parámetros (se esperaba 400)."

#: includes/admin/class-profile-connections.php:28
msgid "AI connections"
msgstr "Conexiones de IA"

#: includes/admin/class-profile-connections.php:30
msgid "No AI client is connected to this account."
msgstr "Ningún cliente de IA está conectado a esta cuenta."

#: includes/admin/class-profile-connections.php:35
#: includes/admin/views/tab-connect.php:27
#: includes/admin/views/tab-connections.php:17
#: includes/admin/views/tab-log.php:42
msgid "Client"
msgstr "Cliente"

#: includes/admin/class-profile-connections.php:35
#: includes/admin/views/tab-connections.php:18
msgid "Access"
msgstr "Acceso"

#: includes/admin/class-profile-connections.php:35
#: includes/admin/views/tab-connections.php:20
msgid "Last used"
msgstr "Último uso"

#: includes/admin/class-profile-connections.php:57
#: includes/admin/views/tab-connections.php:36
